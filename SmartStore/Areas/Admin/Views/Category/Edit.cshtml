@model SmartStore_Models.Category

<form method="post" style="margin-top: 30px;">
    <input asp-for="Id" hidden />
    <div class="border p-3 bg-white mt-4">

        <div class="form-group row text-center mb-4">
            <h2 class="offset-4 col-8">Редагувати категорію</h2>
        </div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DisplayOrder"></label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>

    </div>

    <div class="button-container">
        <div class="buttons">

            <button type="button" class="action-button turnback-button" onclick="window.location.href='@Url.Action("Index", "Category")'">
                <i class="fas fa-arrow-left"></i> Повернутись
            </button>

            <button type="submit" class="action-button update-button">
                <i class="fas fa-sync-alt"></i> Оновити
            </button>

        </div>
    </div>

</form>

@section Scripts{

    @{
        <partial name="_ValidationScriptsPartial" />
    }

}