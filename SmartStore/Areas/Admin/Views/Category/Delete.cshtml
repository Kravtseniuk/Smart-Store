@model SmartStore_Models.Category

<form method="post" asp-action="DeletePost" style="margin-top: 30px;">
    <input asp-for="Id" hidden />
    <div class="border p-3 bg-white mt-4">

        <div class="form-group row text-center mb-4">
            <h2 class="offset-4 col-8">Видалити категорію</h2>
        </div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" disabled class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="DisplayOrder"></label>
            <input asp-for="DisplayOrder" disabled class="form-control" />
        </div>

    </div>

    <div class="button-container">
        <div class="buttons">
            <button type="button" class="action-button turnback-button" onclick="window.location.href='@Url.Action("Index", "Category")'">
                <i class="fas fa-arrow-left"></i> Повернутись
            </button>

            <button type="submit" class="action-button delete-button">
                <i class="fas fa-trash-alt"></i> Видалити
            </button>

        </div>
    </div>

</form>

@section Scripts{

    @{
        <partial name="_ValidationScriptsPartial" />
    }

}